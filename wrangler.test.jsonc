{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digisign",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server-entry.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "digisign",
			"database_id": "00000000-0000-4000-8000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "digisign-storage"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "Q_EVENTS",
				"queue": "ds-events"
			}
		],
		"consumers": [
			{
				"queue": "ds-events",
				"max_batch_size": 5,
				"max_batch_timeout": 2,
				"max_retries": 5,
				"dead_letter_queue": "ds-dlq"
			}
		]
	},
	"triggers": {
		"crons": ["* * * * *"]
	}
}
